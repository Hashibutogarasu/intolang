import "intolang://builtin/std";

init {
    into previous: Int32 = 0;
    into current: Int32 = 1;
    into index: Int32 = 0;

    println("Fibonacci sequence");

    while (index < 10) {
        println(previous);

        into next: Int32 = previous + current;
        previous = current;
        current = next;
        index = index + 1;
    }
}
