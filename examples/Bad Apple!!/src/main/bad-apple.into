import "intolang://builtin/std";
import "wayland://window";
import "vulkan://core";
import "ffmpeg://decoder";
import "ffmpeg://audio";
import "sdl2://audio";
import "fs://file";
import "path://std";
import "cpp://standard/time";
import "ps://process";
import "ps://events";
import "asset://require";

require("res");

pub event audioReady(sampleRate: Int32, channels: Int32) {}

pub event frameShown(frame: Int32) {}

pub event stopping(signal: Int32) {}

pub Settings() {
    pub into: Int32 width = 854;
    pub into: Int32 height = 480;
    pub into: String title = "Bad Apple!!";
}

now into settings = Settings();
now into windowSettings = settings.copy();

now into self = Process.current();
println(self.toString());
println(self.hash());

now into stop = 0;
now into audioStarted = 0;
now into shownFrames = 0;

now into onTerm = self.signal.on(Signal.SIGTERM, (signal) => {
    stopping.emit(signal);
});
now into onInterrupt = self.signal.on(Signal.SIGINT, (signal) => {
    stopping.emit(signal);
});
now into onStop = stopping.on((signal) => {
    stop = 1;
});
now into onFrame = frameShown.on((frame) => {
    shownFrames = shownFrames + 1;
});
now into onAudio = audioReady.on((sampleRate, channels) => {
    audioStarted = 1;
});
now into onExit = exited.on((process, code) => {
    println("Bad Apple!! stopped");
});

now into wayland = Wayland();
wayland.window.create(windowSettings.width, windowSettings.height, windowSettings.title);
now into titleBar = wayland.window.titlebar.create();

now into vulkan = Vulkan();
wayland.setRenderer(vulkan);

now into ffmpeg = FFmpeg();
now into video = ffmpeg.read(asset("res/badapple.mp4"));

now into soundFile = File();
now into soundBytes = soundFile.read(asset("res/badapple.mp4"));
now into audio = openAudioBuffer(soundBytes);

now into output = SDL2Audio();
now into sampleRate = audio.sampleRate();
now into channels = audio.channels();
now into speaker = output.open(sampleRate, channels);

now into audioThread = thread {
    now into* format = audio.format();
    now into* codec = audio.decoder();
    now into* packet = audio.packet();
    now into* audioFrame = audio.frame();
    now into* resampler = audio.resampler();
    now into audioStream = audio.streamIndex();

    into reading = 0;
    into received = 0;

    while (reading >= 0) {
        if (stop == 1) {
            break;
        }
        reading = readAudioFrame(format, packet);
        if (reading >= 0) {
            now into packetStream = audioPacketStream(packet);
            if (packetStream == audioStream) {
                sendAudioPacket(codec, packet);
                received = receiveAudioFrame(codec, audioFrame);
                while (received == 0) {
                    now into sampleCount = audioFrameSamples(audioFrame);
                    now into capacity = audio.outCapacity();
                    now into* planes = audio.reserve(capacity);
                    now into* source = audioFrameData(audioFrame);
                    now into produced = convertAudio(resampler, planes, capacity, source, sampleCount);
                    now into perChannel = produced * channels;
                    now into byteCount = perChannel * 2;
                    now into* pcm = audio.buffer();
                    speaker.queue(pcm, byteCount);
                    unrefAudioFrame(audioFrame);
                    received = receiveAudioFrame(codec, audioFrame);
                }
            }
            unrefAudioPacket(packet);
        }
    }
    speaker.resume();
    audioReady.emit(sampleRate, channels);
};

now into watcherThread = thread {
    while (stop == 0) {
        dispatch(self);
        sleep(10);
    }
};

now into watchTask = watcherThread.run();
now into audioTask = audioThread.run();

init {
    while (audioStarted == 0) {
        if (stop == 1) {
            break;
        }
        sleep(5);
    }

    into delay = video.delayMs();
    into start = monotonicMilliseconds();
    into frame = 0;

    while (wayland.window.isOpen()) {
        if (stop == 1) {
            break;
        }
        if (video.next()) {
            into text = video.text();
            vulkan.beginFrame(0);
            vulkan.drawText(text, 16777215);
            wayland.window.present();

            frame = frame + 1;
            frameShown.emit(frame);
            into elapsed = frame * delay;
            into deadline = start + elapsed;
            into now = monotonicMilliseconds();
            into wait = deadline - now;
            if (wait > 0) {
                sleep(wait);
            }
        } else {
            break;
        }
    }
}

stopping.emit(0);
await audioTask;
await watchTask;
println(shownFrames);
exit(self, 0);
