import "wayland://window";
import "vulkan://core";
import "ffmpeg://decoder";
import "path://std";
import "cpp://standard/time";

into wayland: Wayland = Wayland();
wayland.window.create(854, 480, "Bad Apple!!");
now into titleBar: TitleBar = wayland.window.titlebar.create();

into vulkan: Vulkan = Vulkan();
wayland.setRenderer(vulkan);

into ffmpeg: FFmpeg = FFmpeg();
now into source: Path = pathAbsolute("res/badapple.mp4");
into video: Video = ffmpeg.read(source);

init {
    into delay: Int32 = video.delayMs();
    into start: Int32 = monotonicMilliseconds();
    into frame: Int32 = 0;

    while (wayland.window.isOpen()) {
        if (video.next()) {
            into text: String = video.text();
            vulkan.beginFrame(0);
            vulkan.drawText(text, 16777215);
            wayland.window.present();

            frame = frame + 1;
            into elapsed: Int32 = frame * delay;
            into deadline: Int32 = start + elapsed;
            into now: Int32 = monotonicMilliseconds();
            into wait: Int32 = deadline - now;
            if (wait > 0) {
                sleep(wait);
            }
        } else {
            break;
        }
    }
}

video.destroy();
vulkan.destroy();
wayland.destroy();
