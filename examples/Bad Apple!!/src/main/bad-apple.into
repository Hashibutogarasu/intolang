import "wayland://window";
import "vulkan://core";
import "ffmpeg://decoder";
import "cpp://standard/time";

init {
    into window = wayland_window_create(854, 480, "Bad Apple!!");
    into display = wayland_window_native_display(window);
    into surface = wayland_window_native_surface(window);
    into renderer = vulkan_wayland_window_create(display, surface, 854, 480);
    into video = ffmpeg_video_open("res/badapple.mp4", 106, 60);
    into delay = ffmpeg_video_frame_delay_ms(video);
    into start = monotonicMilliseconds();
    into frame = 0;

    while (wayland_window_is_open(window)) {
        if (ffmpeg_video_read_frame(video)) {
            into text = ffmpeg_video_text(video);
            vulkan_wayland_window_begin_frame(renderer, 0);
            vulkan_wayland_window_draw_text(renderer, text, 16777215);
            vulkan_wayland_window_present(renderer);

            frame = frame + 1;
            into elapsed = frame * delay;
            into deadline = start + elapsed;
            into now = monotonicMilliseconds();
            into wait = deadline - now;
            if (wait > 0) {
                sleep(wait);
            }
        } else {
            break;
        }
    }

    ffmpeg_video_destroy(video);
    vulkan_wayland_window_destroy(renderer);
    wayland_window_destroy(window);
}
