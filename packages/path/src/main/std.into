pub Path() {
    #[link("cpp", "src/ffi/path/path.cpp", "path_join")]
    pub static fun join(base: Path, leaf: Path): Path;

    #[link("cpp", "src/ffi/path/path.cpp", "path_normalize")]
    pub static fun normalize(value: Path): Path;

    #[link("cpp", "src/ffi/path/path.cpp", "path_absolute")]
    pub static fun absolute(value: Path): Path;

    #[link("cpp", "src/ffi/path/path.cpp", "path_parent")]
    pub static fun parent(value: Path): Path;

    #[link("cpp", "src/ffi/path/path.cpp", "path_file_name")]
    pub static fun fileName(value: Path): Path;

    #[link("cpp", "src/ffi/path/path.cpp", "path_extension")]
    pub static fun extension(value: Path): String;

    #[link("cpp", "src/ffi/path/path.cpp", "path_stem")]
    pub static fun stem(value: Path): Path;
}
