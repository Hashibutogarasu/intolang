import "fs://file";

pub FFmpeg() {
    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_new")]
    pub cpp fun new(): FFmpeg;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_open_buffer")]
    pub cpp fun openBuffer(data: Bytes): Video;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_read")]
    pub cpp fun openPath(path: Path): Video;

    pub fun read(path: Path): Video {
        now into file: File = File();
        late into data: Bytes = file.read(path);
        now into video: Video = this.openBuffer(data);
        return video;
    }
}

pub Video() {
    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_video_columns")]
    pub cpp fun columns(): Int32;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_video_rows")]
    pub cpp fun rows(): Int32;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_video_frame_delay_ms")]
    pub cpp fun delayMs(): Int32;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_video_read_frame")]
    pub cpp fun next(): Boolean;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_video_text")]
    pub cpp fun text(): String;

    #[link("cpp", "src/main/native/ffmpeg/decoder.cpp", "ffmpeg_video_destroy")]
    pub cpp fun destroy(): Void;
}
