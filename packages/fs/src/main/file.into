enum Format {
    Text,
    Binary,
}

pub File() {
    #[link("c", "src/ffi/fs/file.c", "fs_file_new")]
    pub c fun new(): File;

    pub fun read(path: String): Binary {
        return Binary.read(path);
    }

    pub fun write(path: String, binary: Binary, format: Format): Boolean {
        return binary.write(path);
    }

    #[link("c", "src/ffi/fs/file.c", "fs_file_destroy")]
    pub override c fun destroy(): Void;
}
