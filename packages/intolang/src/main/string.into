pub String() {
    #[link("c", "src/ffi/string.c", "into_string_concat")]
    pub static fun concat(left: String, right: String): String;

    #[link("c", "src/ffi/string.c", "into_string_from_char")]
    pub static fun fromChar(value: Char): String;

    #[link("c", "src/ffi/string.c", "into_string_equals")]
    pub static fun equals(left: String, right: String): Boolean;

    #[link("c", "src/ffi/string.c", "into_string_length")]
    pub fun length(): Int32;

    #[link("c", "src/ffi/string.c", "into_string_at")]
    pub fun at(index: Int32): Char;

    #[link("c", "src/ffi/string.c", "into_string_substring")]
    pub fun subString(start: Int32, end: Int32): String;

    #[link("c", "src/ffi/string.c", "into_string_index_of")]
    pub fun indexOf(needle: String): Int32;

    #[link("c", "src/ffi/string.c", "into_string_starts_with")]
    pub fun startsWith(prefix: String): Boolean;

    #[link("c", "src/ffi/string.c", "into_string_ends_with")]
    pub fun endsWith(suffix: String): Boolean;

    #[link("c", "src/ffi/string.c", "into_string_to_lower")]
    pub fun toLower(): String;

    #[link("c", "src/ffi/string.c", "into_string_to_upper")]
    pub fun toUpper(): String;

    pub static fun ofInt(value: Int64): String {
        if (value == 0) {
            return "0";
        }
        into negative = value < 0;
        into rest: Int64 = value;
        if (negative) {
            rest = 0 - rest;
        }
        into digits = "";
        while (rest > 0) {
            into digit: Int32 = (rest % 10) as Int32;
            digits = (('0' as Int32) + digit) as Char + digits;
            rest = rest / 10;
        }
        if (negative) {
            return "-" + digits;
        }
        return digits;
    }

    pub fun toInt(): Int64 {
        into total: Int64 = 0;
        into negative = false;
        into i: Int32 = 0;
        while (i < this.length() && this.at(i) == ' ') {
            i = i + 1;
        }
        if (i < this.length() && this.at(i) == '-') {
            negative = true;
            i = i + 1;
        }
        while (i < this.length()) {
            into ch = this.at(i);
            if (ch < '0' || ch > '9') {
                return total;
            }
            into digit: Int32 = (ch as Int32) - 48;
            into wide: Int64 = digit;
            total = total * 10 + wide;
            i = i + 1;
        }
        if (negative) {
            return 0 - total;
        }
        return total;
    }
}
