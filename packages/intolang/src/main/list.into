/// A growing sequence of values, held in native memory.
pub List<T>() {
    /// Makes an empty list.
    #[link("c", "src/ffi/list.c", "into_list_new")]
    pub static fun new(): Pointer;

    #[link("c", "src/ffi/list.c", "into_list_push_int")]
    pub fun pushInt(value: Int64): Void;

    #[link("c", "src/ffi/list.c", "into_list_get_int")]
    pub fun getInt(index: Int32): Int64;

    #[link("c", "src/ffi/list.c", "into_list_set_int")]
    pub fun setInt(index: Int32, value: Int64): Void;

    #[link("c", "src/ffi/list.c", "into_list_push_float")]
    pub fun pushFloat(value: Float64): Void;

    #[link("c", "src/ffi/list.c", "into_list_get_float")]
    pub fun getFloat(index: Int32): Float64;

    #[link("c", "src/ffi/list.c", "into_list_set_float")]
    pub fun setFloat(index: Int32, value: Float64): Void;

    #[link("c", "src/ffi/list.c", "into_list_push_pointer")]
    pub fun pushString(value: String): Void;

    #[link("c", "src/ffi/list.c", "into_list_get_pointer")]
    pub fun getString(index: Int32): String;

    #[link("c", "src/ffi/list.c", "into_list_set_pointer")]
    pub fun setString(index: Int32, value: String): Void;

    #[link("c", "src/ffi/list.c", "into_list_push_pointer")]
    pub fun pushPointer(value: Pointer): Void;

    #[link("c", "src/ffi/list.c", "into_list_get_pointer")]
    pub fun getPointer(index: Int32): Pointer;

    #[link("c", "src/ffi/list.c", "into_list_set_pointer")]
    pub fun setPointer(index: Int32, value: Pointer): Void;

    /// The number of values in the list.
    #[link("c", "src/ffi/list.c", "into_list_length")]
    pub fun length(): Int32;

    /// Releases the memory of the list.
    #[link("c", "src/ffi/list.c", "into_list_free")]
    pub fun free(): Void;
}
